NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/linkedin-ai-agent

JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/gmail/callback
GMAIL_SENDER_EMAIL=you@gmail.com

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/integrations/linkedin/callback
LINKEDIN_API_VERSION=202610

APP_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

REDIS_URL=redis://localhost:6379

TOKEN_ENCRYPTION_KEY=32-byte-hex-or-base64-key-for-aes-256

FILE_STORAGE_PROVIDER=local
FILE_STORAGE_CONFIGURATION={"basePath":"./storage/documents"}

DAILY_GENERATION_CRON=0 10 * * *
SCHEDULED_POST_CRONS=0 10 * * *,0 14 * * *
APP_TIMEZONE=Asia/Kolkata
APPROVAL_EXPIRY_HOURS=48

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
MAX_UPLOAD_BYTES=10485760

COOKIE_SECURE=false
